[user]
  name = John Watson
  email = john@dctrwatson.com

[alias]
  st = status -sb
  co = checkout
  ci = commit
  lol = log --pretty=format:'%Cred%h %Creset%s %Cgreen(%an)' --graph --decorate
  new = ls-files --others --exclude-standard
  added = diff --cached --name-only
  newauthor = commit --amend --reset-author -C HEAD
  subtree-add = "!f() { if [ \"$#\" -ne 3 ]; then echo \"usage: git subtree-add <repository> <prefix> <ref>\" >&2; return 2; fi; git subtree add --prefix=\"$2\" \"$1\" \"$3\" --squash; }; f"
  subtree-pull = "!f() { if [ \"$#\" -ne 3 ]; then echo \"usage: git subtree-pull <repository> <prefix> <ref>\" >&2; return 2; fi; git subtree pull --prefix=\"$2\" \"$1\" \"$3\" --squash; }; f"

  prune-branches = "!f() { git fetch --prune && git for-each-ref --format='%(refname:short) %(upstream:track)' refs/heads | awk '$2 == \"[gone]\" { print $1 }' | while IFS= read -r branch; do git branch -D -- \"$branch\"; done; }; f"

[format]
  pretty = %C(magenta reverse)%h%Creset %Cgreen[%cr]%Creset (%an) %s

[diff]
  algorithm = histogram
  wordRegex = [^[:space:]]+

[interactive]
  diffFilter = diff-so-fancy --patch

[color]
  ui = auto

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
	whitespace = red reverse
	meta = 11
	frag = magenta bold
	old = red bold
	new = green bold
	commit = yellow bold
	func = 146 bold

[color "diff-highlight"]
	oldNormal = red bold
	oldHighlight = red bold 52
	newNormal = green bold
	newHighlight = green bold 22

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[help]
  autocorrect = 1

[core]
  whitespace = tabwidth=4,trailing-space,cr-at-eol
  autocrlf = input
  pager = "diff-so-fancy | less --tabs=4 -RFX"

[push]
  default = simple
  autoSetupRemote = true

[pull]
  rebase = true

[rebase]
  autoSquash = true
  updateRefs = true

[rerere]
  enabled = true

[branch]
  sort = -committerdate

[tag]
  sort = -version:refname

[transfer]
  fsckobjects = true

[fetch]
  prune = true

[url "git@github.com:"]
	insteadOf = https://github.com/

[merge]
	conflictStyle = zdiff3

[init]
	defaultBranch = main

[gpg]
	format = ssh

[commit]
	gpgsign = true

[include]
  path = ~/.local_gitconfig
